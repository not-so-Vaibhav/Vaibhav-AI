GEMINI_API_KEY=your_new_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated website origins, for example: https://your-site.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=40
# Optional locally. When set, callers must send it as x-api-key.
CLIENT_API_KEY=replace_with_a_long_random_value
